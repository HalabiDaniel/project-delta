# paperwars.io server settings (v0.0.10). Copy to .env for local development; never commit .env.
# In production, set these in the hosting provider's environment settings instead.

# PostgreSQL. Without it the server keeps everything in memory (nothing survives a restart).
DATABASE_URL=postgres://paperwars:paperwars@localhost:5432/paperwars

# The database the automated tests use (each test file gets its own throw-away schema).
TEST_DATABASE_URL=postgres://paperwars:paperwars@localhost:5432/paperwars_test

# Secret mixed into every stored token and code hash. Required in production: at least 16
# characters, e.g. the output of: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it logs every player out (their tokens no longer match).
TOKEN_PEPPER=

# open: anyone who reaches the server gets a player. invite: a first join needs an invite code.
# Default: invite when NODE_ENV=production, open otherwise.
ACCESS=open

PORT=2567
# NODE_ENV=production
