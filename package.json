{
  "name": "paper-air-wars",
  "version": "0.0.10-dev",
  "private": true,
  "description": "paperwars.io v0.0.10 (in development) - persistent multiplayer: player identity, PostgreSQL, recovery and a private alpha",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "tsx server/index.ts",
    "server:watch": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "build:deploy": "npm run licensed:fetch && npm run build && npm run compress",
    "compress": "node tools/compress-dist.mjs",
    "licensed:check": "tsx tools/licensed.ts check",
    "licensed:fetch": "tsx tools/licensed.ts fetch",
    "validate-glb": "tsx tools/validate-glb.ts",
    "measure": "node tools/measure-perf.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "loadtest": "tsx server/loadtest.ts",
    "bots": "tsx server/bots/run.ts",
    "admin": "tsx server/admin.ts",
    "db:migrate": "tsx server/db/cli.ts",
    "db:up": "docker compose up -d postgres",
    "export-models": "node tools/export-models.mjs"
  },
  "dependencies": {
    "@colyseus/core": "^0.18.23",
    "@colyseus/schema": "^5.0.43",
    "@colyseus/sdk": "^0.18.9",
    "@colyseus/ws-transport": "^0.18.4",
    "pg": "^8.23.1",
    "playcanvas": "^2.23.3"
  },
  "devDependencies": {
    "@colyseus/testing": "^0.18.6",
    "@types/pg": "^8.23.1",
    "three": "^0.160.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
